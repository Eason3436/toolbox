// EnRecall iOS 設定
//
// 後端網址和 key 不放在公開的 repo：CI 從 GitHub Actions Secrets
// （ENRECALL_SUPABASE_HOST、ENRECALL_SUPABASE_ANON_KEY）寫出 Secrets.xcconfig，這個檔案在 .gitignore 裡。
// 沒有 Secrets.xcconfig 時是 PLACEHOLDER：連接器、單字商店都會關掉，其他功能照常（Preview、單元測試就是這樣）。
// xcconfig 會把 // 當成註解，所以網址只寫主機名稱，程式裡再補 https://

SUPABASE_HOST = PLACEHOLDER
SUPABASE_ANON_KEY = PLACEHOLDER

#include? "Secrets.xcconfig"
