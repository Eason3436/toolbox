// DrivePlayer 設定
//
// Google Client ID 不放在 repo：CI 從 GitHub Actions Secrets
// （GOOGLE_CLIENT_ID、GOOGLE_REVERSED_CLIENT_ID）寫出 Secrets.xcconfig，這個檔案在 .gitignore 裡。
// 沒有 Secrets.xcconfig 時是 PLACEHOLDER：App 照樣能開，登入會顯示「尚未設定」。
// TMDB API Key 不編進 App：在 App 的「設定」輸入，存在 iPhone 的鑰匙圈。
// 範本見 Secrets.xcconfig.template。

GOOGLE_CLIENT_ID = PLACEHOLDER
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.placeholder

#include? "Secrets.xcconfig"
